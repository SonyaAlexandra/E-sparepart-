{
  "name": "sparepart-mgmt-assets",
  "version": "1.0.0",
  "description": "Frontend assets for Sparepart Management System",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "npx tailwindcss -i ./css/input.css -o ../web/static/css/app.css --minify",
    "build:js": "npx esbuild ./js/main.js --bundle --minify --outfile=../web/static/js/app.js",
    "watch": "npx tailwindcss -i ./css/input.css -o ../web/static/css/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.13",
    "daisyui": "^4.10.1",
    "esbuild": "^0.20.2",
    "tailwindcss": "^3.4.3"
  },
  "dependencies": {
    "alpinejs": "^3.13.10",
    "htmx.org": "^1.9.12"
  }
}
